rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      let email = request.auth.token.get('email', '');
      return isSignedIn() && (
        (email.lower() == "fabricasoftwareai@gmail.com") ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------
    
    function isValidOrder(data) {
      return data.items is list && 
             data.total is number && 
             data.status in ['pending', 'preparing', 'ready', 'completed', 'cancelled'] &&
             data.createdAt is string;
    }

    function isValidProfile(data) {
      return data.userId is string && 
             data.email is string &&
             data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // RULES
    // -------------------------------------------------------------------------

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'photoURL', 'customerName', 'customerPhone', 'preferredRole', 'mpConnected', 'mpPublicKey', 'mpAccessToken']) || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Restricted list reads for customers, full read for admins
      allow read: if (isSignedIn() && existing().get('userId', '') == request.auth.uid) || isAdmin();
      
      allow create: if isSignedIn() && isValidOrder(incoming());
      
      // Only admins can update status or payment info
      allow update: if isAdmin();
      
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /paymentMethods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
