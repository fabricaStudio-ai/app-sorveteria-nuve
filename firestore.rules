rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // HELPERS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      let email = request.auth.token.get('email', '');
      return isSignedIn() && (
        (email.lower() == "fabricasoftwareai@gmail.com") ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // -------------------------------------------------------------------------
    // VALIDATION HELPERS
    // -------------------------------------------------------------------------
    
    function isValidOrder(data) {
      return data.items is list && 
             data.total is number && 
             data.status in ['pending_payment', 'received', 'preparing', 'shipped', 'ready_for_pickup', 'completed', 'cancelled'] &&
             data.deliveryMethod in ['delivery', 'pickup'] &&
             data.createdAt is string;
    }

    function isValidProfile(data) {
      return data.userId is string && 
             data.email is string &&
             data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // RULES
    // -------------------------------------------------------------------------

    match /stores/{storeId} {
      allow read, write: if isOwner(storeId) || isAdmin();

      match /products/{productId} {
        allow read: if true;
        allow write: if isOwner(storeId) || isAdmin();
      }

      match /orders/{orderId} {
        allow read, write: if isOwner(storeId) || isAdmin();
      }
    }
    
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isOwner(adminId) || isAdmin();
      allow write: if isAdmin();
    }

    match /profiles/{userId} {
      allow read: if isOwner(userId) || isAdmin() || (isSignedIn() && resource.data.mpConnected == true);
      allow list: if isSignedIn() && resource.data.mpConnected == true;
      allow create: if isOwner(userId) && isValidProfile(incoming());
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
        'name', 'phone', 'photoURL', 'customerName', 'customerPhone', 
        'preferredRole', 'mpConnected', 'mpPublicKey', 'mpAccessToken',
        'lalamoveConnected', 'lalamoveApiKey', 'lalamoveSecret', 'imgbbApiKey'
      ]) || isAdmin();
      allow delete: if isAdmin();

      // Secrets subcollection for sensitive tokens
      match /private/secrets {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      // Allow read if owner or admin
      allow read: if (isSignedIn() && (resource == null || resource.data.userId == request.auth.uid)) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      
      allow create: if isValidOrder(incoming());
      
      // Admins have full control. Owners can only cancel pending payment orders.
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        incoming().diff(existing()).affectedKeys().hasOnly(['status']) &&
        incoming().status == 'cancelled' &&
        existing().status == 'pending_payment'
      );
      
      allow delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /paymentMethods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
