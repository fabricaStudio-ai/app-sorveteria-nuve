{
  "entities": {
    "Store": {
      "title": "Store",
      "description": "Ice cream shop details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "logoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Ice cream and related items scoped to a store",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "image": { "type": "string" }
      },
      "required": ["storeId", "name", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders scoped to a store",
      "type": "object",
      "properties": {
        "storeId": { "type": "string" },
        "userId": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["storeId", "total", "status"]
    },
    "Profile": {
      "title": "Profile",
      "description": "User profile data linked to a store",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["userId", "email"]
    }
  },
  "firestore": {
    "stores": {
      "schema": "Store",
      "description": "List of all stores"
    },
    "stores/{storeId}/products": {
      "schema": "Product",
      "description": "Products per store"
    },
    "stores/{storeId}/orders": {
      "schema": "Order",
      "description": "Orders per store"
    },
    "profiles": {
      "schema": "Profile",
      "description": "User profiles"
    }
  }
}
