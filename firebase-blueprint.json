{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Ice cream and related items",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string", "enum": ["sorvetes", "milkshakes", "acai", "combos", "promocao"] },
        "image": { "type": "string" },
        "rating": { "type": "number" },
        "isBestSeller": { "type": "boolean" },
        "tag": { "type": "string" }
      },
      "required": ["name", "description", "price", "category", "image"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "delivering", "completed", "cancelled"] },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["items", "total", "status", "createdAt"]
    },
    "Profile": {
      "title": "Profile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["userId", "email"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial transaction",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["income", "expense"] },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "userId": { "type": "string" }
      },
      "required": ["type", "amount", "date", "category"]
    },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Available payment methods",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["pix", "card", "cash"] },
        "isActive": { "type": "boolean" },
        "details": { "type": "string" }
      },
      "required": ["name", "type", "isActive"]
    }
  },
  "firestore": {
    "products": {
      "schema": "Product",
      "description": "List of available products"
    },
    "orders": {
      "schema": "Order",
      "description": "Customer order history"
    },
    "profiles": {
      "schema": "Profile",
      "description": "Customer profiles"
    },
    "transactions": {
      "schema": "Transaction",
      "description": "Financial records (income/expenses)"
    },
    "paymentMethods": {
      "schema": "PaymentMethod",
      "description": "Configurations for payment forms"
    }
  }
}
