{
  "version": 2,
  "functions": {
    "api/**/*": {
      "includeFiles": "{dist/server.cjs,firebase-applet-config.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
